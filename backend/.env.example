# Server Configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/archscale_auth

# Supabase Identity Provider
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client Application (Set to your Vercel deployment URL in production)
FRONTEND_URL=https://your-app.vercel.app # For local dev: http://localhost:5173

# Security & Secrets
COOKIE_SECRET=your_32_char_minimum_cookie_secret_key_here!
OTP_ENCRYPTION_KEY=your_32_char_encryption_key_here_phrase!

# Email Service (Option A: Resend, Option B: SMTP/Gmail)
MAIL_PROVIDER_KEY=re_your_resend_api_key_here
MAIL_FROM="ArchScale Auth <onboarding@resend.dev>"

# Optional SMTP (Gmail / Custom SMTP to send to ANY email address)
# SMTP_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Platform Seed Accounts
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_EMAIL=admin@example.com
